<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1D4A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="34dp">

        <!-- ===================================================== -->
        <!-- ROBOT -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- ROBOT AREA -->
            <FrameLayout
                android:layout_width="500dp"
                android:layout_height="300dp">

                <!-- Radar Ring 1 -->
                <View
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radar_circle"
                    android:alpha="1"/>

                <!-- Radar Ring 2 -->
                <View
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_radar_circle"
                    android:alpha="5"/>

                <!-- Glow -->
                <View
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="1dp"
                    android:background="@drawable/bg_glow_circle"
                    android:alpha="2"/>

                <!-- Bottom Glow -->
                <View
                    android:layout_width="120dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="54dp"
                    android:background="@drawable/bg_bottom_glow"
                    android:alpha="10"/>

                <!-- Robot -->
                <ImageView
                    android:id="@+id/imgRobot"
                    android:layout_width="500dp"
                    android:layout_height="400dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_robot_argo_real"/>

            </FrameLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-16dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="AUTONOMOUS DELIVERY SYSTEM"
                android:textColor="#00E38C"
                android:textSize="11sp"/>

            <!-- Logo -->
            <ImageView
                android:layout_width="230dp"
                android:layout_height="129dp"
                android:layout_marginTop="-30dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_argo_logo" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- DASHBOARD -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMonitor"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="34dp"
            app:cardBackgroundColor="#A8E85C"
            app:cardCornerRadius="22dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="18dp">

                <!-- Icon -->
                <LinearLayout
                    android:layout_width="40dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_box">


                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_monitor"
                        android:tint="#000000"/>

                </LinearLayout>

                <!-- Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DASHBOARD"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow"
                    android:tint="#000000"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ===================================================== -->
        <!-- LIVE MAPS -->
        <!-- ===================================================== -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMaps"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#141B2D"
            app:cardCornerRadius="22dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <!-- Icon -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:background="@drawable/bg_icon_dark">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_maps"
                        android:tint="#00E38C"/>

                </LinearLayout>

                <!-- Text -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAPS"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                </LinearLayout>

                <!-- Arrow -->
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow"
                    android:tint="#FFFFFF"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>